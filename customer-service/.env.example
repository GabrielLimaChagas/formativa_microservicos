# Configurações do Customer Service
PORT=5001

# Banco de Dados NoSQL: MongoDB / Azure Cosmos DB (API MongoDB)
# Exemplo Local (Docker):
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/
# Exemplo Azure Cosmos DB (API MongoDB):
# MONGODB_CONNECTION_STRING=mongodb://<cosmos-account>:<key>@<cosmos-account>.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<cosmos-account>@

MONGODB_DATABASE=customers_db

# Mensageria Assíncrona: Azure Service Bus
# Se vazio, opera em modo fallback in-memory para testes locais
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=customer-events
