# Configurações do Customer Service
PORT=5001

# Banco de Dados NoSQL: MongoDB Atlas ou Azure Cosmos DB for MongoDB
# Exemplo Local (Docker Compose):
MONGODB_URI=mongodb://localhost:27017/customers_db
MONGODB_DB_NAME=customers_db

# Exemplo Produção Azure Cosmos DB for MongoDB / MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@<CLUSTER>.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# MONGODB_DB_NAME=customers_db

# Mensageria Assíncrona: Azure Service Bus
# Se vazio, opera em modo fallback in-memory para testes locais
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=customer-events
