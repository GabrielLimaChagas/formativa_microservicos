# Configurações do Customer Service
PORT=5001

# Banco de Dados Relacional: Azure SQL Database / SQL Server
# Exemplo Produção Azure SQL (pyodbc / mssql):
# AZURE_SQL_CONNECTION_STRING=mssql+pyodbc://<USUARIO>:<SENHA>@<SERVIDOR>.database.windows.net:1433/sqldb-customers?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30

# Fallback Local (se AZURE_SQL_CONNECTION_STRING não for informada, utiliza SQLite local)
DATABASE_URL=sqlite:///customers.db

# Mensageria Assíncrona: Azure Service Bus
# Se vazio, opera em modo fallback in-memory para testes locais
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=customer-events
