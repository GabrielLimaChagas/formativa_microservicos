# Configurações do API Gateway / BFF
PORT=5000

# Microsserviços Internos
CUSTOMERS_SERVICE_URL=http://localhost:5001
PRODUCTS_SERVICE_URL=http://localhost:5002

# Segurança: Centralizada via JWT (Bearer Token)
# Secret para assinatura e verificação HMAC-SHA256
JWT_SECRET_KEY=sua-chave-secreta-super-segura-jwt-2026
JWT_ALGORITHM=HS256

# Tempo de expiração de token em segundos (ex.: 3600 = 1 hora)
JWT_EXPIRATION_SECONDS=3600
