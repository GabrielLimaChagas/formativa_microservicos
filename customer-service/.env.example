# Configurações do Customer Service
PORT=5001

# Banco de Dados: Azure SQL Database (Produção)
# AZURE_SQL_CONNECTION_STRING=mssql+pyodbc://<username>:<password>@sqldb-customers.database.windows.net:1433/customers_db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30

# Fallback Local SQLite (utilizado automaticamente se AZURE_SQL_CONNECTION_STRING estiver vazia)
DATABASE_URL=sqlite:///customers.db

# Mensageria Assíncrona: Azure Service Bus
# Se vazio, opera em fallback in-memory/no-op para testes locais
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=customer-events
